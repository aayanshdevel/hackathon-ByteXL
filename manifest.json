{
  "manifest_version": 3,
  "name": "DRP Guard",
  "version": "0.2.0",
  "description": "Website impersonation detection and cookie security analysis",
  "permissions": [
    "activeTab",
    "tabs",
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
