
{
  "manifest_version": 3,
  "name": "DRP Guard",
  "version": "0.1.0",
  "description": "Phishing URL check + cookie security report",

  "permissions": [
    "activeTab",
    "tabs",
    "cookies",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:3000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  }
}
